#!/usr/bin/env bash
# noisefloor — команда на хосте: версии, обновление, откат.
#
# Зачем она нужна, если есть docker compose pull && up -d: потому что pull
# и up — это половина дела. Вторая половина — убедиться, что новая версия
# поднялась, и вернуть прежнюю, если нет. Для чужих установок эта половина
# важнее первой: разбираться в логах никто не будет.
#
# Ту же работу делает кнопка «Обновить» в панели: панель кладёт файл-запрос
# в свой каталог данных, systemd-юнит (см. install-agent) зовёт `noisefloor
# watch`, и дальше всё идёт этим же кодом. Контейнер сам себя не
# перезапускает, docker.sock в него не пробрасывается.
#
#   noisefloor status              версии и здоровье сервисов на этом хосте
#   noisefloor check               есть ли обновления
#   noisefloor update [panel|relay] [тег]  обновить (по умолчанию всё; тег — например v1.2.0)
#   noisefloor rollback [panel|relay] вернуть предыдущую версию вместе с её данными
#   noisefloor install-agent       поставить systemd-юнит для кнопки «Обновить» (панель и релей)
#   noisefloor watch               (для systemd) обработать запрос от панели или релея
#
# Где искать сервисы: /etc/noisefloor/services (пишет установщик), строки
# вида panel=/opt/noisefloor-panel. Если файла нет — обход /opt/*/.
set -euo pipefail

AGENT_VERSION=2
SERVICES_FILE=${NOISEFLOOR_SERVICES_FILE:-/etc/noisefloor/services}
REQUEST_TARGET=""
REPO=vbif666/noisefloor
PANEL_IMAGE=vbif666/noisefloor-amneziawg-panel
RELAY_IMAGE=vbif666/noisefloor-vless-reality
HEALTH_TIMEOUT=${NOISEFLOOR_HEALTH_TIMEOUT:-150}
# Сколько ждать зелёную канарейку после обновления, если до него она была зелёной.
CANARY_TIMEOUT=${NOISEFLOOR_CANARY_TIMEOUT:-300}
CANARY_FRESH_SECONDS=180
SNAPSHOTS_KEPT=2
# Не входит в копию данных и не трогается при откате: логи и архивы большие,
# канарейка пересоздаёт свой каталог сама, остальное - обмен панели с агентом.
DATA_EXCLUDE=(backups logs cascade-xray.log bin-backup canary
              update-request.json update-result.json agent.json)
ROLLBACK_MARKER=.rollback-data

log()  { printf '\033[1;32m[noisefloor]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[noisefloor]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[noisefloor] ОШИБКА:\033[0m %s\n' "$*" >&2; exit 1; }

command -v docker >/dev/null || die "docker не найден"
docker compose version >/dev/null 2>&1 || die "нужен плагин docker compose"

# ------------------------------------------------------------ сервисы ---

# Печатает строки "имя<TAB>каталог<TAB>образ".
services() {
    if [ -f "$SERVICES_FILE" ]; then
        while IFS='=' read -r name dir; do
            case "$name" in
                panel) [ -f "$dir/docker-compose.yml" ] && printf 'panel\t%s\t%s\n' "$dir" "$PANEL_IMAGE" ;;
                relay) [ -f "$dir/docker-compose.yml" ] && printf 'relay\t%s\t%s\n' "$dir" "$RELAY_IMAGE" ;;
            esac
        done < "$SERVICES_FILE"
        return
    fi
    for f in /opt/*/docker-compose.yml; do
        [ -f "$f" ] || continue
        dir=$(dirname "$f")
        if grep -q "$PANEL_IMAGE" "$f"; then printf 'panel\t%s\t%s\n' "$dir" "$PANEL_IMAGE"
        elif grep -q "$RELAY_IMAGE" "$f"; then printf 'relay\t%s\t%s\n' "$dir" "$RELAY_IMAGE"
        fi
    done
}

service_dir() { services | awk -F'\t' -v n="$1" '$1==n{print $2; exit}'; }

# Канарейку пропускаем: здоровье и образ определяет основной контейнер.
container_id() {
    (cd "$1" && docker compose ps -q "$(docker compose config --services | grep -vx canary | head -1)" 2>/dev/null | head -1)
}

container_env() { # каталог переменная
    local id; id=$(container_id "$1")
    [ -n "$id" ] || return 1
    docker inspect "$id" --format '{{range .Config.Env}}{{println .}}{{end}}' | awk -F= -v k="$2" '$1==k{print substr($0, length(k)+2); exit}'
}

running_image() { # каталог -> id образа работающего контейнера
    local id; id=$(container_id "$1")
    [ -n "$id" ] && docker inspect "$id" --format '{{.Image}}'
}

health() { # каталог -> healthy|unhealthy|starting|none|absent
    local id; id=$(container_id "$1")
    [ -n "$id" ] || { echo absent; return; }
    docker inspect "$id" --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{if .State.Running}}none{{else}}absent{{end}}{{end}}'
}

wait_healthy() { # каталог
    local dir="$1" waited=0 st
    while [ "$waited" -lt "$HEALTH_TIMEOUT" ]; do
        st=$(health "$dir")
        case "$st" in
            healthy|none) return 0 ;;
            unhealthy|absent) [ "$waited" -ge 30 ] && return 1 ;;
        esac
        sleep 5; waited=$((waited + 5))
    done
    return 1
}

# Зелёный результат канарейки не старше момента "с" (секунды эпохи).
canary_green_since() { # каталог с
    local file="$1/data/canary/result.json" ts
    [ -f "$file" ] && grep -q '"ok": true' "$file" || return 1
    ts=$(sed -n 's/.*"ts": \([0-9]*\).*/\1/p' "$file")
    [ -n "$ts" ] && [ "$ts" -ge "$2" ]
}

wait_canary_green() { # каталог с
    local waited=0
    while [ "$waited" -lt "$CANARY_TIMEOUT" ]; do
        canary_green_since "$1" "$2" && return 0
        sleep 5; waited=$((waited + 5))
    done
    return 1
}

# ------------------------------------------------------- копии данных ---

copy_data() { # откуда куда
    local args=() item
    for item in "${DATA_EXCLUDE[@]}"; do args+=("--exclude=./$item"); done
    rm -rf "$2"
    mkdir -p "$2"
    tar -C "$1" "${args[@]}" -cf - . | tar -C "$2" -xpf - || { rm -rf "$2"; return 1; }
}

# Контейнер остановлен, поэтому база и остальные файлы лежат целиком и
# согласованно: снимок через backup API не нужен, и sqlite на хосте тоже.
snapshot_data() { # каталог версия
    local dir="$1" name stale
    name="data.pre-$(printf '%s' "$2" | tr -c 'A-Za-z0-9._-' '_')"
    copy_data "$dir/data" "$dir/$name.tmp" || return 1
    rm -rf "${dir:?}/$name"
    mv "$dir/$name.tmp" "$dir/$name"
    touch "$dir/$name"
    printf '%s\n' "$name" > "$dir/$ROLLBACK_MARKER"
    # shellcheck disable=SC2012
    ls -dt "$dir"/data.pre-* 2>/dev/null | tail -n +$((SNAPSHOTS_KEPT + 1)) | while read -r stale; do
        rm -rf "$stale"
    done
}

# Копия тех данных, с которыми работает образ :previous. Пусто, если её нет:
# обновление шло старым агентом или откат уже был.
rollback_snapshot() { # каталог
    local name
    name=$(cat "$1/$ROLLBACK_MARKER" 2>/dev/null || true)
    if [ -n "$name" ] && [ -d "$1/$name" ]; then echo "$1/$name"; fi
}

# Сначала полная копия рядом: нехватка места обнаружится до удаления.
restore_data() { # каталог копия
    local dir="$1" tmp="$1/data.restoring" item keep=()
    rm -rf "$tmp"
    cp -a "$2" "$tmp" || { rm -rf "$tmp"; return 1; }
    for item in "${DATA_EXCLUDE[@]}"; do keep+=(! -name "$item"); done
    find "$dir/data" -mindepth 1 -maxdepth 1 "${keep[@]}" -exec rm -rf {} +
    find "$tmp" -mindepth 1 -maxdepth 1 -exec mv {} "$dir/data/" \;
    rmdir "$tmp"
}

# ------------------------------------------------------------ результат ---

# Панель показывает содержимое этого файла в блоке «Версия и обновления».
write_result() { # каталог ok сообщение откатились от до
    local dir="$1" ok="$2" msg="$3" rolled="$4" from="$5" to="$6"
    mkdir -p "$dir/data"
    python3 - "$dir/data/update-result.json" "$ok" "$msg" "$rolled" "$from" "$to" <<'PY' 2>/dev/null || true
import json, sys, datetime
path, ok, msg, rolled, frm, to = sys.argv[1:7]
json.dump({
    "finished_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "ok": ok == "1", "message": msg, "rolled_back": rolled == "1",
    "from": frm, "to": to, "agent_version": 1,
}, open(path, "w"), ensure_ascii=False, indent=2)
PY
}

# --------------------------------------------------------------- update ---

update_one() { # имя каталог образ
    local name="$1" dir="$2" image="$3"
    local before after version_before version_after
    log "$name ($dir): проверяю"
    before=$(running_image "$dir" || true)
    version_before=$(container_env "$dir" NOISEFLOOR_VERSION 2>/dev/null || echo "?")

    local ref; ref=$(cd "$dir" && docker compose config --images | head -1)

    # Прежний образ закрепляем тегом :previous ДО pull — пока рабочий тег
    # ещё указывает на него. Именно тегом по ссылке, а не по ID: в
    # containerd-хранилище (Docker с драйвером overlayfs) образ без тега и
    # без контейнера убирает сборщик мусора сразу, а тег, поставленный на
    # голый ID скачанного образа, там не держится. Один лишний образ на
    # диске — цена того, что откат вообще возможен.
    #
    # Сам :previous переставляем только когда версия правда сменилась. Иначе
    # проверка «уже актуально» затёрла бы его текущей версией, и откат вернул бы
    # копию данных без её образа.
    local repo tag held
    repo=$(image_repo "$dir"); tag=$(channel_tag "$dir" "${REQUEST_TARGET:-}")
    held="$repo:pre-update"
    if [ -n "$before" ]; then
        if [ "$(docker image inspect "$ref" --format '{{.Id}}' 2>/dev/null)" = "$before" ]; then
            docker tag "$ref" "$held"
        else
            docker tag "$before" "$held" 2>/dev/null || true
        fi
    fi

    log "$name: скачиваю $repo:$tag"
    docker pull -q "$repo:$tag" >/dev/null || {
        docker rmi "$held" >/dev/null 2>&1 || true
        write_result "$dir" 0 "не удалось скачать $repo:$tag" 0 "$version_before" "?"
        die "$name: не удалось скачать $repo:$tag"
    }
    docker tag "$repo:$tag" "$ref"
    after=$(docker image inspect "$ref" --format '{{.Id}}')

    if [ -n "$before" ] && [ "$before" = "$after" ]; then
        docker rmi "$held" >/dev/null 2>&1 || true
        log "$name: уже актуально ($version_before)"
        write_result "$dir" 1 "уже актуально" 0 "$version_before" "$version_before"
        return 0
    fi
    if [ -n "$before" ] && docker image inspect "$held" >/dev/null 2>&1; then
        docker tag "$held" "$(previous_ref "$dir")"
        docker rmi "$held" >/dev/null 2>&1 || true
    fi

    # Каскад обязан вернуться, только если работал до обновления.
    local canary_was_green=0 started
    canary_green_since "$dir" "$(( $(date +%s) - CANARY_FRESH_SECONDS ))" && canary_was_green=1

    if [ -n "$before" ]; then
        log "$name: останавливаю и копирую данные"
        (cd "$dir" && docker compose stop) >/dev/null 2>&1 || warn "$name: compose stop вернул ошибку"
        if ! snapshot_data "$dir" "$version_before"; then
            docker tag "$(previous_ref "$dir")" "$ref"
            (cd "$dir" && docker compose up -d) >/dev/null 2>&1 || true
            write_result "$dir" 0 "не удалось скопировать данные, обновление отменено" 0 "$version_before" "$version_before"
            die "$name: не удалось скопировать данные (места на диске?), обновление отменено"
        fi
    fi

    log "$name: перезапускаю"
    started=$(date +%s)
    (cd "$dir" && docker compose up -d) >/dev/null 2>&1 || warn "$name: compose up вернул ошибку, проверяю здоровье"

    local failure=""
    if ! wait_healthy "$dir"; then
        failure="новая версия не поднялась за ${HEALTH_TIMEOUT} с"
    elif [ "$canary_was_green" = 1 ] && { log "$name: жду канарейку"; ! wait_canary_green "$dir" "$started"; }; then
        failure="каскад работал до обновления и не вернулся за ${CANARY_TIMEOUT} с"
    fi

    if [ -z "$failure" ]; then
        version_after=$(container_env "$dir" NOISEFLOOR_VERSION 2>/dev/null || echo "?")
        log "$name: обновлено ($version_before → $version_after)"
        write_result "$dir" 1 "обновлено до $version_after" 0 "$version_before" "$version_after"
        return 0
    fi

    warn "$name: $failure — возвращаю прежнюю версию и её данные"
    if rollback_one "$name" "$dir" "$image" quiet; then
        write_result "$dir" 0 "$failure, возвращена прежняя версия ($version_before)" 1 "$version_before" "$version_before"
        die "$name: обновление не удалось, возвращена прежняя версия. Логи: docker logs $(cd "$dir" && docker compose ps -q | head -1)"
    fi
    write_result "$dir" 0 "$failure, откат тоже не удался" 0 "$version_before" "?"
    die "$name: обновление не удалось И откат не удался — нужны руки: cd $dir && docker compose logs"
}

# Какой тег скачивать. Явный (v1.2.0 из запроса панели или аргумента) —
# его; иначе по каналу из .env панели: latest — каждый коммит, stable
# (по умолчанию) — последний релиз. Compose при этом продолжает смотреть на
# :latest — скачанный образ подставляется под этот тег локально. Так у
# канала stable на сервере оказывается именно релиз, а не «что там сейчас
# собралось из master».
channel_tag() { # каталог [явный тег]
    local dir="$1" explicit="${2:-}" channel
    case "$explicit" in v[0-9]*) echo "$explicit"; return ;; esac
    channel=$(grep -s '^UPDATE_CHANNEL=' "$dir/.env" | tail -1 | cut -d= -f2- | tr -d '[:space:]"'"'"'')
    [ "$channel" = latest ] && echo latest || echo stable
}

image_repo() { (cd "$1" && docker compose config --images | head -1 | sed 's/:[^:/]*$//'); }

# Тег, под которым лежит прежняя версия: vbif666/…-panel:previous.
previous_ref() {
    local repo
    repo=$(cd "$1" && docker compose config --images | head -1 | sed 's/:[^:/]*$//')
    echo "$repo:previous"
}

rollback_one() { # имя каталог образ [quiet]
    local name="$1" dir="$2" image="$3" prev snapshot
    prev=$(previous_ref "$dir")
    docker image inspect "$prev" >/dev/null 2>&1 \
        || { [ "${4:-}" = quiet ] || warn "$name: прежней версии не сохранено ($prev)"; return 1; }
    local ref; ref=$(cd "$dir" && docker compose config --images | head -1)
    snapshot=$(rollback_snapshot "$dir")
    if [ -n "$snapshot" ]; then
        (cd "$dir" && docker compose stop) >/dev/null 2>&1 || warn "$name: compose stop вернул ошибку"
        # Руками откатываются и через дни: всё, что появилось с обновления, иначе
        # пропало бы без следа.
        if { [ "${4:-}" = quiet ] || copy_data "$dir/data" "$dir/data.before-rollback"; } \
            && restore_data "$dir" "$snapshot"; then
            rm -f "$dir/$ROLLBACK_MARKER"
            [ "${4:-}" = quiet ] || log "$name: данные на момент обновления возвращены, прежние лежат в $dir/data.before-rollback"
        else
            warn "$name: данные вернуть не удалось, версия остаётся прежней"
            (cd "$dir" && docker compose up -d) >/dev/null 2>&1 || true
            return 1
        fi
    else
        [ "${4:-}" = quiet ] || warn "$name: копии данных нет, возвращаю только образ"
    fi
    # Возвращаем прежний образ под рабочий тег: следующий pull перезапишет.
    docker tag "$prev" "$ref"
    (cd "$dir" && docker compose up -d) >/dev/null 2>&1 || true
    if wait_healthy "$dir"; then
        [ "${4:-}" = quiet ] || { log "$name: возвращена прежняя версия"; write_result "$dir" 1 "возвращена прежняя версия" 1 "?" "$(container_env "$dir" NOISEFLOOR_VERSION 2>/dev/null || echo "?")"; }
        return 0
    fi
    return 1
}

for_each() { # функция [имя]
    local fn="$1" want="${2:-}" found=0
    while IFS=$'\t' read -r name dir image; do
        [ -z "$want" ] || [ "$want" = "$name" ] || continue
        found=1
        "$fn" "$name" "$dir" "$image"
    done < <(services)
    [ "$found" = 1 ] || die "сервисы не найдены${want:+ ($want)}. Ожидался docker-compose.yml в /opt/* или запись в $SERVICES_FILE"
}

# ---------------------------------------------------------------- check ---

check_one() { # имя каталог образ
    local name="$1" dir="$2" image="$3"
    local version sha local_digest remote_digest
    version=$(container_env "$dir" NOISEFLOOR_VERSION 2>/dev/null || echo "?")
    sha=$(container_env "$dir" NOISEFLOOR_BUILD_SHA 2>/dev/null || echo "?")
    local tag; tag=$(channel_tag "$dir")
    local_digest=$(docker image inspect "$(cd "$dir" && docker compose config --images | head -1)" --format '{{index .RepoDigests 0}}' 2>/dev/null | cut -d@ -f2 || true)
    remote_digest=$(curl -fsS --max-time 10 "https://hub.docker.com/v2/repositories/$image/tags/$tag" 2>/dev/null \
        | python3 -c 'import sys,json; print(json.load(sys.stdin).get("digest",""))' 2>/dev/null || true)
    printf '%-6s %-28s коммит %-8s канал %-7s' "$name" "$version" "$sha" "$tag"
    if [ -z "$remote_digest" ]; then
        echo "— реестр недоступен"
    elif [ -z "$local_digest" ]; then
        echo "— образ собран локально, с реестром не сравнить"
    elif [ "$local_digest" = "$remote_digest" ]; then
        echo "— это последняя версия"
    else
        echo "— в реестре есть новее: noisefloor update $name"
    fi
}

cmd_check() {
    local release
    release=$(curl -fsS --max-time 10 "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null \
        | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("tag_name",""), (d.get("published_at") or "")[:10])' 2>/dev/null || true)
    [ -n "$release" ] && echo "последний релиз: $release  (https://github.com/$REPO/releases)"
    for_each check_one "${1:-}"
}

# --------------------------------------------------------------- status ---

status_one() { # имя каталог образ
    local name="$1" dir="$2"
    printf '%-6s %-28s %-10s %s\n' "$name" \
        "$(container_env "$dir" NOISEFLOOR_VERSION 2>/dev/null || echo '—')" \
        "$(health "$dir")" "$dir"
}

cmd_status() { printf '%-6s %-28s %-10s %s\n' "сервис" "версия" "здоровье" "каталог"; for_each status_one "${1:-}"; }

# ---------------------------------------------------------- агент/systemd ---

# Агент один на хост и обслуживает оба сервиса: и панель, и релей кладут
# запрос в свой каталог данных, path-юнит ждёт любой из них. До версии 2
# агент ставился только рядом с панелью, и у релея кнопки «Обновить»
# не было вовсе.
cmd_install_agent() {
    local found=0 paths=""
    while IFS=$'\t' read -r name dir image; do
        found=1
        paths="$paths
PathExists=$dir/data/update-request.json"
    done < <(services)
    [ "$found" = 1 ] || die "на этом хосте не найдено ни панели, ни релея"
    command -v systemctl >/dev/null || die "нет systemd — кнопка «Обновить» работать не будет, остаётся noisefloor update"

    cat > /etc/systemd/system/noisefloor-updater.service <<EOF
[Unit]
Description=NOISEFLOOR: обновление по запросу из панели или релея
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/noisefloor watch
EOF
    cat > /etc/systemd/system/noisefloor-updater.path <<EOF
[Unit]
Description=NOISEFLOOR: ждать запроса на обновление

[Path]$paths

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    # Юнит мог быть уже включён старой версией с другим списком путей —
    # перезапуск заставляет systemd перечитать [Path].
    systemctl enable noisefloor-updater.path >/dev/null 2>&1
    systemctl restart noisefloor-updater.path >/dev/null 2>&1
    while IFS=$'\t' read -r name dir image; do
        mkdir -p "$dir/data"
        printf '{"installed_at": "%s", "agent_version": %s}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$AGENT_VERSION" > "$dir/data/agent.json"
        log "$name: кнопка «Обновить» теперь работает"
    done < <(services)
}

# Убрать файлы-запросы в самом конце, что бы ни случилось: path-юнит
# срабатывает заново, пока файл существует, и без этого неудачное
# обновление зациклилось бы. Список глобальный: trap выполняется уже вне
# функции, и local к тому моменту не существует — первый прогон агента
# на этом и попался.
REQUEST_FILES=""
cleanup_requests() { for f in $REQUEST_FILES; do rm -f "$f"; done; }

cmd_watch() {
    local want_relay=0 want_panel=0 target=""
    while IFS=$'\t' read -r name dir image; do
        local req="$dir/data/update-request.json"
        [ -f "$req" ] || continue
        REQUEST_FILES="$REQUEST_FILES $req"
        [ "$name" = relay ] && want_relay=1
        [ "$name" = panel ] && want_panel=1
        [ -n "$target" ] || target=$(python3 -c 'import sys,json; print(json.load(open(sys.argv[1])).get("target",""))' "$req" 2>/dev/null || true)
    done < <(services)
    [ -n "$REQUEST_FILES" ] || exit 0
    trap cleanup_requests EXIT
    REQUEST_TARGET="$target"
    log "запрос на обновление (${REQUEST_TARGET:-по каналу})"
    # Обновляется только то, что попросило. Если просили оба — панель
    # последней: её перезапуск рвёт соединение с самим оператором.
    [ "$want_relay" = 1 ] && for_each update_one relay
    [ "$want_panel" = 1 ] && for_each update_one panel
    return 0
}

# ----------------------------------------------------------------- main ---

case "${1:-}" in
    status)        cmd_status "${2:-}" ;;
    check)         cmd_check "${2:-}" ;;
    update)        REQUEST_TARGET="${3:-}"; for_each update_one "${2:-}" ;;
    rollback)      for_each rollback_one "${2:-}" ;;
    install-agent) cmd_install_agent ;;
    watch)         cmd_watch ;;
    *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
