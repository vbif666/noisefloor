#!/usr/bin/env bash
# noisefloor — команда на хосте: версии, обновление, откат.
#
# Зачем она нужна, если есть docker compose pull && up -d: потому что pull
# и up — это половина дела. Вторая половина — убедиться, что новая версия
# поднялась, и вернуть прежнюю, если нет. Для чужих установок эта половина
# важнее первой: разбираться в логах никто не будет.
#
# Ту же работу делает кнопка «Обновить» в панели: панель кладёт файл-запрос
# в свой каталог данных, systemd-юнит (см. install-agent) зовёт `noisefloor
# watch`, и дальше всё идёт этим же кодом. Контейнер сам себя не
# перезапускает, docker.sock в него не пробрасывается.
#
#   noisefloor status              версии и здоровье сервисов на этом хосте
#   noisefloor check               есть ли обновления
#   noisefloor update [panel|relay] обновить (по умолчанию — всё, что есть)
#   noisefloor rollback [panel|relay] вернуть предыдущую версию
#   noisefloor install-agent       поставить systemd-юнит для кнопки в панели
#   noisefloor watch               (для systemd) обработать запрос от панели
#
# Где искать сервисы: /etc/noisefloor/services (пишет установщик), строки
# вида panel=/opt/noisefloor-panel. Если файла нет — обход /opt/*/.
set -euo pipefail

AGENT_VERSION=1
SERVICES_FILE=/etc/noisefloor/services
REPO=vbif666/noisefloor
PANEL_IMAGE=vbif666/noisefloor-amneziawg-panel
RELAY_IMAGE=vbif666/noisefloor-vless-reality
HEALTH_TIMEOUT=150

log()  { printf '\033[1;32m[noisefloor]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[noisefloor]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[noisefloor] ОШИБКА:\033[0m %s\n' "$*" >&2; exit 1; }

command -v docker >/dev/null || die "docker не найден"
docker compose version >/dev/null 2>&1 || die "нужен плагин docker compose"

# ------------------------------------------------------------ сервисы ---

# Печатает строки "имя<TAB>каталог<TAB>образ".
services() {
    if [ -f "$SERVICES_FILE" ]; then
        while IFS='=' read -r name dir; do
            case "$name" in
                panel) [ -f "$dir/docker-compose.yml" ] && printf 'panel\t%s\t%s\n' "$dir" "$PANEL_IMAGE" ;;
                relay) [ -f "$dir/docker-compose.yml" ] && printf 'relay\t%s\t%s\n' "$dir" "$RELAY_IMAGE" ;;
            esac
        done < "$SERVICES_FILE"
        return
    fi
    for f in /opt/*/docker-compose.yml; do
        [ -f "$f" ] || continue
        dir=$(dirname "$f")
        if grep -q "$PANEL_IMAGE" "$f"; then printf 'panel\t%s\t%s\n' "$dir" "$PANEL_IMAGE"
        elif grep -q "$RELAY_IMAGE" "$f"; then printf 'relay\t%s\t%s\n' "$dir" "$RELAY_IMAGE"
        fi
    done
}

service_dir() { services | awk -F'\t' -v n="$1" '$1==n{print $2; exit}'; }

container_id() { (cd "$1" && docker compose ps -q 2>/dev/null | head -1); }

container_env() { # каталог переменная
    local id; id=$(container_id "$1")
    [ -n "$id" ] || return 1
    docker inspect "$id" --format '{{range .Config.Env}}{{println .}}{{end}}' | awk -F= -v k="$2" '$1==k{print substr($0, length(k)+2); exit}'
}

running_image() { # каталог -> id образа работающего контейнера
    local id; id=$(container_id "$1")
    [ -n "$id" ] && docker inspect "$id" --format '{{.Image}}'
}

health() { # каталог -> healthy|unhealthy|starting|none|absent
    local id; id=$(container_id "$1")
    [ -n "$id" ] || { echo absent; return; }
    docker inspect "$id" --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{if .State.Running}}none{{else}}absent{{end}}{{end}}'
}

wait_healthy() { # каталог
    local dir="$1" waited=0 st
    while [ "$waited" -lt "$HEALTH_TIMEOUT" ]; do
        st=$(health "$dir")
        case "$st" in
            healthy|none) return 0 ;;
            unhealthy|absent) [ "$waited" -ge 30 ] && return 1 ;;
        esac
        sleep 5; waited=$((waited + 5))
    done
    return 1
}

# ------------------------------------------------------------ результат ---

# Панель показывает содержимое этого файла в блоке «Версия и обновления».
write_result() { # каталог ok сообщение откатились от до
    local dir="$1" ok="$2" msg="$3" rolled="$4" from="$5" to="$6"
    mkdir -p "$dir/data"
    python3 - "$dir/data/update-result.json" "$ok" "$msg" "$rolled" "$from" "$to" <<'PY' 2>/dev/null || true
import json, sys, datetime
path, ok, msg, rolled, frm, to = sys.argv[1:7]
json.dump({
    "finished_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "ok": ok == "1", "message": msg, "rolled_back": rolled == "1",
    "from": frm, "to": to, "agent_version": 1,
}, open(path, "w"), ensure_ascii=False, indent=2)
PY
}

# --------------------------------------------------------------- update ---

update_one() { # имя каталог образ
    local name="$1" dir="$2" image="$3"
    local before after version_before version_after
    log "$name ($dir): проверяю"
    before=$(running_image "$dir" || true)
    version_before=$(container_env "$dir" NOISEFLOOR_VERSION 2>/dev/null || echo "?")

    local ref; ref=$(cd "$dir" && docker compose config --images | head -1)

    # Прежний образ закрепляем тегом :previous ДО pull — пока рабочий тег
    # ещё указывает на него. Именно тегом по ссылке, а не по ID: в
    # containerd-хранилище (Docker с драйвером overlayfs) образ без тега и
    # без контейнера убирает сборщик мусора сразу, а тег, поставленный на
    # голый ID скачанного образа, там не держится. Один лишний образ на
    # диске — цена того, что откат вообще возможен.
    if [ -n "$before" ]; then
        if [ "$(docker image inspect "$ref" --format '{{.Id}}' 2>/dev/null)" = "$before" ]; then
            docker tag "$ref" "$(previous_ref "$dir")"
        else
            docker tag "$before" "$(previous_ref "$dir")" 2>/dev/null || true
        fi
    fi

    (cd "$dir" && docker compose pull -q) || { write_result "$dir" 0 "docker compose pull не удался" 0 "$version_before" "?"; die "$name: не удалось скачать образ"; }
    after=$(docker image inspect "$ref" --format '{{.Id}}')

    if [ -n "$before" ] && [ "$before" = "$after" ]; then
        log "$name: уже актуально ($version_before)"
        write_result "$dir" 1 "уже актуально" 0 "$version_before" "$version_before"
        return 0
    fi

    log "$name: перезапускаю"
    (cd "$dir" && docker compose up -d) >/dev/null 2>&1 || warn "$name: compose up вернул ошибку, проверяю здоровье"

    if wait_healthy "$dir"; then
        version_after=$(container_env "$dir" NOISEFLOOR_VERSION 2>/dev/null || echo "?")
        log "$name: обновлено ($version_before → $version_after)"
        write_result "$dir" 1 "обновлено до $version_after" 0 "$version_before" "$version_after"
        return 0
    fi

    warn "$name: новая версия не поднялась за ${HEALTH_TIMEOUT} с — возвращаю прежнюю"
    if rollback_one "$name" "$dir" "$image" quiet; then
        write_result "$dir" 0 "новая версия не поднялась, возвращена прежняя ($version_before)" 1 "$version_before" "$version_before"
        die "$name: обновление не удалось, возвращена прежняя версия. Логи: docker logs $(cd "$dir" && docker compose ps -q | head -1)"
    fi
    write_result "$dir" 0 "новая версия не поднялась, откат тоже не удался" 0 "$version_before" "?"
    die "$name: обновление не удалось И откат не удался — нужны руки: cd $dir && docker compose logs"
}

# Тег, под которым лежит прежняя версия: vbif666/…-panel:previous.
previous_ref() {
    local repo
    repo=$(cd "$1" && docker compose config --images | head -1 | sed 's/:[^:/]*$//')
    echo "$repo:previous"
}

rollback_one() { # имя каталог образ [quiet]
    local name="$1" dir="$2" image="$3" prev
    prev=$(previous_ref "$dir")
    docker image inspect "$prev" >/dev/null 2>&1 \
        || { [ "${4:-}" = quiet ] || warn "$name: прежней версии не сохранено ($prev)"; return 1; }
    local ref; ref=$(cd "$dir" && docker compose config --images | head -1)
    # Возвращаем прежний образ под рабочий тег: следующий pull перезапишет.
    docker tag "$prev" "$ref"
    (cd "$dir" && docker compose up -d) >/dev/null 2>&1 || true
    if wait_healthy "$dir"; then
        [ "${4:-}" = quiet ] || { log "$name: возвращена прежняя версия"; write_result "$dir" 1 "возвращена прежняя версия" 1 "?" "$(container_env "$dir" NOISEFLOOR_VERSION 2>/dev/null || echo "?")"; }
        return 0
    fi
    return 1
}

for_each() { # функция [имя]
    local fn="$1" want="${2:-}" found=0
    while IFS=$'\t' read -r name dir image; do
        [ -z "$want" ] || [ "$want" = "$name" ] || continue
        found=1
        "$fn" "$name" "$dir" "$image"
    done < <(services)
    [ "$found" = 1 ] || die "сервисы не найдены${want:+ ($want)}. Ожидался docker-compose.yml в /opt/* или запись в $SERVICES_FILE"
}

# ---------------------------------------------------------------- check ---

check_one() { # имя каталог образ
    local name="$1" dir="$2" image="$3"
    local version sha local_digest remote_digest
    version=$(container_env "$dir" NOISEFLOOR_VERSION 2>/dev/null || echo "?")
    sha=$(container_env "$dir" NOISEFLOOR_BUILD_SHA 2>/dev/null || echo "?")
    local_digest=$(docker image inspect "$image:latest" --format '{{index .RepoDigests 0}}' 2>/dev/null | cut -d@ -f2 || true)
    remote_digest=$(curl -fsS --max-time 10 "https://hub.docker.com/v2/repositories/$image/tags/latest" 2>/dev/null \
        | python3 -c 'import sys,json; print(json.load(sys.stdin).get("digest",""))' 2>/dev/null || true)
    printf '%-6s %-28s коммит %-8s ' "$name" "$version" "$sha"
    if [ -z "$remote_digest" ]; then
        echo "— реестр недоступен"
    elif [ -z "$local_digest" ]; then
        echo "— образ собран локально, с реестром не сравнить"
    elif [ "$local_digest" = "$remote_digest" ]; then
        echo "— это последняя версия"
    else
        echo "— в реестре есть новее: noisefloor update $name"
    fi
}

cmd_check() {
    local release
    release=$(curl -fsS --max-time 10 "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null \
        | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("tag_name",""), (d.get("published_at") or "")[:10])' 2>/dev/null || true)
    [ -n "$release" ] && echo "последний релиз: $release  (https://github.com/$REPO/releases)"
    for_each check_one "${1:-}"
}

# --------------------------------------------------------------- status ---

status_one() { # имя каталог образ
    local name="$1" dir="$2"
    printf '%-6s %-28s %-10s %s\n' "$name" \
        "$(container_env "$dir" NOISEFLOOR_VERSION 2>/dev/null || echo '—')" \
        "$(health "$dir")" "$dir"
}

cmd_status() { printf '%-6s %-28s %-10s %s\n' "сервис" "версия" "здоровье" "каталог"; for_each status_one "${1:-}"; }

# ---------------------------------------------------------- агент/systemd ---

cmd_install_agent() {
    local panel_dir; panel_dir=$(service_dir panel)
    [ -n "$panel_dir" ] || die "панель на этом хосте не найдена — агент нужен только ей"
    command -v systemctl >/dev/null || die "нет systemd — кнопка в панели работать не будет, остаётся noisefloor update"

    cat > /etc/systemd/system/noisefloor-updater.service <<EOF
[Unit]
Description=NOISEFLOOR: обновление по запросу из панели
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/noisefloor watch
EOF
    cat > /etc/systemd/system/noisefloor-updater.path <<EOF
[Unit]
Description=NOISEFLOOR: ждать запроса на обновление из панели

[Path]
PathExists=$panel_dir/data/update-request.json

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable --now noisefloor-updater.path >/dev/null 2>&1
    mkdir -p "$panel_dir/data"
    printf '{"installed_at": "%s", "agent_version": %s}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$AGENT_VERSION" > "$panel_dir/data/agent.json"
    log "агент установлен: кнопка «Обновить» в панели теперь работает"
}

cmd_watch() {
    local panel_dir; panel_dir=$(service_dir panel)
    [ -n "$panel_dir" ] || exit 0
    REQUEST_PATH="$panel_dir/data/update-request.json"
    [ -f "$REQUEST_PATH" ] || exit 0
    # Пока файл лежит, панель показывает «агент обновляет». Убираем его в
    # самом конце, что бы ни случилось: path-юнит срабатывает заново, пока
    # файл существует, и без trap неудачное обновление зациклилось бы.
    # Переменная нарочно глобальная: trap выполняется уже вне функции, и
    # local к тому моменту не существует — первый прогон на этом и попался.
    trap 'rm -f "$REQUEST_PATH"' EXIT
    log "запрос из панели — обновляю всё, что есть на хосте"
    # Панель — последней: её перезапуск рвёт соединение с самим оператором.
    # Релея на этом хосте может и не быть — это не ошибка.
    (for_each update_one relay) 2>/dev/null || true
    for_each update_one panel
}

# ----------------------------------------------------------------- main ---

case "${1:-}" in
    status)        cmd_status "${2:-}" ;;
    check)         cmd_check "${2:-}" ;;
    update)        for_each update_one "${2:-}" ;;
    rollback)      for_each rollback_one "${2:-}" ;;
    install-agent) cmd_install_agent ;;
    watch)         cmd_watch ;;
    *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
