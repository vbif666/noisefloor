# TCP port for the actual VLESS+Reality endpoint (443 is usually already taken
# by another TLS service on the host - pick a free port).
VLESS_PORT=8443

# HTTP port for the status/QR web page.
PANEL_PORT=8001

# Camouflage target: Reality proxies the fake TLS handshake to this real site.
# Must be a real TLS 1.3 site that supports the domain in REALITY_SNI.
# NOTE: don't switch this to www.microsoft.com - some of its CDN edges return
# an OCSP-stapled Certificate record >8192 bytes, which trips a known upstream
# REALITY bug (XTLS/Xray-core issue #6356) and silently drops every real
# client with "processed invalid connection ... handshake did not complete
# successfully". dl.google.com works reliably instead.
REALITY_DEST=dl.google.com:443

# SNI clients will present / server will masquerade as. Leave empty to derive
# it from REALITY_DEST's hostname automatically.
REALITY_SNI=

# Public IP/domain to put into the generated vless:// link. Leave empty to
# auto-detect via ifconfig.me at request time.
PUBLIC_HOST=

# Label shown in client apps and in the vless:// link fragment. Give each
# deployment its own value so multiple endpoints are distinguishable in a
# client app's server list.
LABEL=vless-reality

# HTTP Basic auth for the admin panel. Leave ADMIN_PASSWORD empty to
# auto-generate one on first start (saved to ./data/INITIAL_ADMIN_PASSWORD.txt).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Cosmetic browser-tab title / heading only - kept generic on purpose so the
# page doesn't reveal it's a VPN endpoint. Does not affect the vless:// link.
APP_NAME=NOISEFLOOR
APP_CODENAME=Relay-01
