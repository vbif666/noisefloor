# Admin login for the web panel (HTTP form + JWT, not HTTP Basic).
# Leave ADMIN_PASSWORD empty to auto-generate one on first start (saved to
# ./data/INITIAL_ADMIN_PASSWORD.txt inside the data volume).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# JWT signing secret. Leave empty to auto-generate one on first start and
# persist it into ./data (so restarting the container doesn't invalidate
# existing login sessions).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# AmneziaWG interface name this panel manages, and where its .conf lives.
AWG_INTERFACE=awg0
AWG_CONFIG_DIR=/etc/amnezia/amneziawg

# Network interface with the internet route, for the NAT/MASQUERADE rule.
# "auto" detects it from the default route at apply time.
EGRESS_INTERFACE=auto

# Whether the panel is allowed to actually run awg/awg-quick against the live
# interface (requires cap_add: NET_ADMIN + /dev/net/tun in docker-compose.yml,
# see below). If false, or if the awg tools aren't available, the panel still
# works fully as a config generator - "Apply" will just report ok=false.
LIVE_MANAGEMENT_ENABLED=true
# Bring the interface up automatically on container start (equivalent to
# clicking "Apply" once after every restart) instead of requiring a manual
# first click in the UI.
AUTO_APPLY_ON_START=true

# Defaults used only once, the first time the panel provisions its
# ServerConfig row (fresh ./data, no existing database) - after that they're
# just normal editable settings in the "Сервер" tab.
DEFAULT_SERVER_ADDRESS=10.13.13.1/24
DEFAULT_LISTEN_PORT=443
DEFAULT_DNS=1.1.1.1

# Как перехватывать трафик клиентов в каскад:
#   tproxy   - TCP и UDP: QUIC и DNS тоже идут через каскад. Значение по
#              умолчанию и единственный режим, в котором каскад делает то,
#              что обещает. Требует ядро 6.x+: на 5.15 xray не может
#              выставить IP_TRANSPARENT на TCP-слушателе, и ядро дропает
#              весь TCP клиентов (панель это заметит и напишет в ошибку
#              каскада, но чинится только сменой режима или ядра).
#   redirect - только TCP; UDP уйдёт напрямую с реальным адресом сервера.
#              Оставлен как путь отката, в том числе для старых ядер.
CASCADE_INTERCEPT_MODE=tproxy

# Резать ли клиентам QUIC (UDP/443), пока каскад работает в режиме redirect.
# В этом режиме UDP в каскад не заворачивается и уходит напрямую с настоящим
# адресом сервера, а браузер предпочитает QUIC обычному TCP - то есть
# основная часть трафика шла бы мимо каскада, да ещё и с другим IP, чем
# остальные соединения того же клиента. Отказ приходит с
# icmp-port-unreachable, поэтому браузер сразу берёт TCP и задержки не
# возникает. В режиме tproxy настройка ни на что не влияет.
CASCADE_BLOCK_QUIC=true

# Заворачивать ли DNS клиентов в каскад в режиме redirect: панель поднимает
# свой слушатель, запрос уходит наружу по TCP через тот же VLESS-выход.
# По умолчанию выключено - каждый непопавший в кэш запрос дорожает примерно
# на один обход каскада, а адрес назначения TCP-соединений и так выбирает
# релей (вход каскада разбирает домен из TLS/HTTP). Включайте, если важно,
# чтобы DNS-резолвер не видел настоящий адрес сервера.
CASCADE_DNS_VIA_CASCADE=false

# Откуда панель узнаёт о своих обновлениях:
#   stable - релизы GitHub (тег vX.Y.Z с заметками): плашка появляется, когда
#            автор сознательно выпустил версию, а текст в ней - его заметки.
#   latest - каждый коммит в master. Свежее, но без гарантий.
UPDATE_CHANNEL=stable

# Запрещать клиентам видеть друг друга внутри туннеля. Включено по
# умолчанию: подключение к одному серверу не повод открывать устройствам
# доступ друг к другу. Ставьте false, только если сознательно ходите между
# своими машинами через этот же туннель.
ISOLATE_CLIENTS=true

# Пароль для шифрования резервных копий (AES-256). Оставите пустым - копии
# будут лежать незашифрованными, а внутри них приватные ключи всех клиентов.
BACKUP_PASSPHRASE=

# Необязательный токен GitHub: поднимает лимит запросов при проверке новых
# версий awg-бинарников. Сама проверка - только запрос к API, без сборки.
AWG_UPDATE_GITHUB_PAT=
